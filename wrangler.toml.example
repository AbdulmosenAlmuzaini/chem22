# للاستخدام مع Wrangler من سطر الأوامر فقط (اختياري).
# إذا رفعتِ المشروع عبر GitHub من لوحة Cloudflare فلا تعيدي تسمية هذا الملف.
name = "chem22"
pages_build_output_dir = "./public"
compatibility_date = "2024-11-01"

[[d1_databases]]
binding = "DB"
database_name = "chem22-db"
database_id = "ضعي-هنا-معرّف-قاعدة-البيانات"
